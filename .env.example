NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GOOGLE_CLIENT_SECRET=
# Public app origin (auth redirect + email unsubscribe link), e.g. https://better-planner.vercel.app
NEXT_PUBLIC_SITE_URL=

# Timer Development Control
# Set to 'true' to enable timer functionality in development
# Set to 'false' to disable timer (prevents conflicts with production data)
NEXT_PUBLIC_ENABLE_TIMER_DEV=true

# Email Notification System
RESEND_API_KEY=                 # resend.com → API Keys (domain must be verified)
EMAIL_FROM=                     # "Better Planner <notifications@yourdomain.com>"
GEMINI_API_KEY=                 # aistudio.google.com — leave empty = generic (non-AI) message
GEMINI_MODEL=gemini-2.5-flash   # optional override
SUPABASE_SERVICE_ROLE_KEY=      # Supabase → Settings → API (server-only, never NEXT_PUBLIC)
# Cron auth: Vercel injects "Authorization: Bearer $CRON_SECRET" when CRON_SECRET is set in the dashboard.
# CRON_SECRET_TOKEN = manual trigger via curl. Set at least one in production.
CRON_SECRET=
CRON_SECRET_TOKEN=
